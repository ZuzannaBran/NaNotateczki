POSTGRES_PASSWORD=replace-with-a-unique-random-secret
APP_DB_PASSWORD=replace-with-another-unique-random-secret
JWT_SECRET=replace-with-at-least-64-random-characters
BASE_DOMAIN=example.invalid
ALLOW_REGISTRATION=false
MAXIMUM_BACKUP_BYTES=67108864
# all (default), disabled (pause writes) or canary (explicit UUIDs)
OPERATIONS_V2_WRITE_MODE=all
OPERATIONS_V2_CANARY_OWNER_IDS=

