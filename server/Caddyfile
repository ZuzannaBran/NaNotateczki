{
    auto_https off
    admin off
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
    }
}

:8080 {
    request_body {
        max_size 70MB
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN} https://cdn.jsdelivr.net; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    @api host {$API_DOMAIN}
    handle @api {
        reverse_proxy api:8000 {
            header_up X-Forwarded-For {client_ip}
        }
    }

    @app host {$APP_DOMAIN}
    handle @app {
        root * /srv/app
        try_files {path} /index.html
        file_server
    }

    respond "Unknown host" 404
}
